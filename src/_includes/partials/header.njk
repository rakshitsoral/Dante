<header id="header" class="header w-full">
    <div class="header-inner flex items-center justify-between gap-4">
        <!-- Logo -->
        <div class="logo-wrapper flex-shrink-0">
            <a href="{{ '/' | url }}" class="logo-link group flex items-center gap-2" aria-label="Rakshit Soral Home">
                <img src="/assets/img/Rakshit Soral Logo_new (1).png" width="260" height="72" loading="eager" alt="Rakshit Soral logo" class="logo-img transition-transform duration-300 group-hover:scale-105">
            </a>
        </div>

        <!-- Navigation Pill Capsule -->
        <nav role="navigation" aria-label="Main Navigation" class="nav-capsule flex items-center">
            <a href="{{ '/' | url }}" class="nav-item {{ 'active' if page.url == '/' }}">
                <span>Home</span>
            </a>
            <a href="/work/" class="nav-item {{ 'active' if '/work' in page.url }}">
                <span>Work</span>
            </a>
            <a href="/about/" class="nav-item {{ 'active' if '/about' in page.url }}">
                <span>About</span>
            </a>
            <a href="/blog/" class="nav-item {{ 'active' if '/blog' in page.url }}">
                <span>Blog</span>
            </a>
            <a href="/resume/" class="nav-item {{ 'active' if '/resume' in page.url }}">
                <span>Resume</span>
            </a>
        </nav>

        <!-- Right Side: Contact / CTA -->
        <div class="header-actions flex items-center gap-3">
            <a href="mailto:rakshitsoral@gmail.com" class="nav-cta-btn group">
                <span>Let's Talk</span>
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"></path>
                </svg>
            </a>
        </div>
    </div>
</header>