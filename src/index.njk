    <!-- Case Study Slider Script -->
    <script>
        let currentCaseIdx = 0;
        const totalCases = 3;

        function showCase(idx) {
            for (let i = 0; i < totalCases; i++) {
                const el = document.getElementById('case-slide-' + i);
                if (el) {
                    if (i === idx) {
                        el.classList.remove('hidden');
                        el.style.opacity = '0';
                        setTimeout(() => { el.style.opacity = '1'; }, 40);
                    } else {
                        el.classList.add('hidden');
                    }
                }
            }
        }

        function nextCase() {
            currentCaseIdx = (currentCaseIdx + 1) % totalCases;
            showCase(currentCaseIdx);
        }

        function prevCase() {
            currentCaseIdx = (currentCaseIdx - 1 + totalCases) % totalCases;
            showCase(currentCaseIdx);
        }
    </script>

