    /* Circular Profile with Dual Rings */
.profile-ring {
  position: relative;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Gold outer ring */
.profile-ring::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4px solid #BF870B;
}

/* Green inner ring */
.profile-ring::after {
  content: "";
  position: absolute;
  inset: 12px;
  border-radius: 50%;
  border: 4px solid #28A745;
}

/* Actual image */
.profile-ring img {
  width: 260px;
  height: 260px;
  object-fit: cover;
  border-radius: 50%;
  z-index: 1;
  background: #000;
}

/* Experience Badge */
.experience-badge {
  position: absolute;
  bottom: -10px;
  right: -10px;
  background: linear-gradient(135deg, #BF870B, #28A745);
  color: #fff;
  font-size: 0.85rem;
  font-weight: 700;
  padding: 0.6rem 1rem;
  border-radius: 9999px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  z-index: 2;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Mobile optimization */
@media (max-width: 768px) {
